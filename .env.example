# Copy to .env and adjust.  .env is NOT in git (it holds the SMTP password).
# chmod 600 .env

# ---- Docker Compose ---------------------------------------------------------
# Laptop: dev   (hugo live-reload server + mailpit)
# Server: leave empty
COMPOSE_PROFILES=dev
# Server with a Dockerised proxy (nginx-proxy / Nginx Proxy Manager):
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=proxy
# SITE_HOSTS=avatax.eu,www.avatax.eu

# Where the web container listens on the host.
# Laptop: 127.0.0.1:8090  -> http://localhost:8090
# Server with host nginx: 127.0.0.1:8090 (host nginx proxies to it)
WEB_BIND=127.0.0.1:8090

# uid/gid that owns ./public (output of hugo). `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# ---- formsvc: mail delivery --------------------------------------------------
# Laptop: everything goes to mailpit (web inbox http://localhost:8026)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASS=
# Server:
# mail.sigalas.eu is the current MX of avatax.eu (shared mail server); adjust if it changes
# SMTP_HOST=mail.sigalas.eu
# mail.sigalas.eu offers 465 (direct TLS); port 587 is not open
# SMTP_PORT=465
# SMTP_TLS=tls
# SMTP_USER=website@avatax.eu
# SMTP_PASS=change-me

SITE_NAME=avatax.eu
MAIL_FROM=Website avatax.eu <website@avatax.eu>
MAIL_TO_CONTACT=info@avatax.eu
# defaults to MAIL_TO_CONTACT
MAIL_TO_CV=

# Random secret for the anti-spam token:  openssl rand -hex 32
TOKEN_SECRET=

# Anti-spam / limits (defaults shown)
# MIN_FILL_SECONDS=3
# RATE_LIMIT=5
# RATE_WINDOW_MINUTES=10
# MAX_UPLOAD_MB=5
